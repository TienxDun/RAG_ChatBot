# ==========================================
# 🌐 ENVIRONMENT DEPLOYMENT SETTINGS
# ==========================================
# Uncomment the block you want to use (Local or Production)

# --- [1] LOCAL DEVELOPMENT ---
# NEXT_PUBLIC_DOTNET_API_URL="http://localhost:5000/api/chat"
# ALLOWED_ORIGINS="http://localhost:3000"

# --- [2] PRODUCTION (Render & Vercel) ---
NEXT_PUBLIC_DOTNET_API_URL="https://your-backend-api.onrender.com/api/chat"
ALLOWED_ORIGINS="https://your-frontend.vercel.app,http://localhost:3000"


# ==========================================
# 🖥️ FRONTEND SETTINGS (Vercel / Local)
# ==========================================
# Note: Variables starting with NEXT_PUBLIC_ are exposed to the browser
NEXT_PUBLIC_API_MODE="dotnet"
NEXT_PUBLIC_MAX_OUTPUT_TOKENS="2048"
NEXT_PUBLIC_TEMPERATURE="0.5"


# ==========================================
# ⚙️ BACKEND SETTINGS (Render / Local)
# ==========================================

# --- VERTEX AI CONFIGURATION ---
VERTEX_API_KEY="YOUR_API_KEY_HERE"
VERTEX_PROJECT_ID="your-project-id"
VERTEX_REGION="global"
VERTEX_LLM_MODEL="gemini-3.1-flash-lite-preview"
VERTEX_EMBED_MODEL="gemini-embedding-001"
VERTEX_EXPRESS_MODE="true"
VERTEX_API_URL_TEMPLATE="https://aiplatform.googleapis.com/v1/publishers/google/models/{modelId}:{action}"

# --- QDRANT CLOUD CONFIGURATION ---
QDRANT_HOST="your-cluster.qdrant.io"
QDRANT_API_KEY="YOUR_QDRANT_API_KEY"
RAG_TOP_K="5"

# --- MSSQL DATABASE CONFIGURATION ---
MSSQL_CONNECTION_STRING="Server=your-server; Database=your-db; User Id=user; Password=pass; Encrypt=True; TrustServerCertificate=True; MultipleActiveResultSets=True;"